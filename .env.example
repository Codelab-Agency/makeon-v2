# Copy to .env.local. Never commit credentials.
# All values below are server-only; do not use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
# Optional clone used to verify migrations; never point this at the main branch.
MIGRATION_TEST_DATABASE_URL=
# Enable only on a disposable local database. Keep false for Neon/shared data.
PAYLOAD_DB_PUSH=false
PAYLOAD_SECRET=
APP_URL=http://localhost:3000
# Exact additional admin origins, comma-separated (e.g. LAN address for local testing).
ADMIN_ALLOWED_ORIGINS=

# Cloudflare R2: S3 API token scoped to this bucket
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain, e.g. https://media.makeon.ro (no trailing slash)
R2_PUBLIC_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mandatory before enabling checkout. Integer bani: 2000 = 20 RON, 0 = free.
SHIPPING_PRICE_BANI=2500

# Sameday AWB integration: server-only credentials, no NEXT_PUBLIC_ prefix.
# Environment: production or sandbox. Credentials must match the chosen environment.
SAMEDAY_ENV=production
SAMEDAY_USERNAME=
SAMEDAY_PASSWORD=

# Dedicated PUBLIC identifiers from Sameday Locker Plugin; served to the map in checkout.
# Never put the courier API password in these fields. The hosted map uses production lockers.
SAMEDAY_LOCKER_CLIENT_ID=
SAMEDAY_LOCKER_API_USERNAME=
# Optional easybox rate in integer bani. Empty uses SHIPPING_PRICE_BANI.
EASYBOX_SHIPPING_PRICE_BANI=

# Resend: use a verified sender domain. Server-only email configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Makeon <info@makeon.ro>"
# Status emails use this sender and the customer's email; resend.dev demo senders are not supported.
CONTACT_EMAIL_TO=

# Only for the one-time bootstrap script; remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
